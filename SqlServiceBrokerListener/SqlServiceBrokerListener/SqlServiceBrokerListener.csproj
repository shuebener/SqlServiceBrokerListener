<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
		  VERSION INTENT — read by the CI release workflow (release.yml)

		  Format : <Major>.<Minor>.0-dev
		  The CI extracts <Major>.<Minor>, queries the latest GitHub Release tag for
		  that series, and increments the patch counter automatically.
		  To start a new minor series, change e.g. 2.0.0-dev -> 2.1.0-dev via PR.
		  The actual release version is injected at build time via -p:Version= and
		  is never written back to this file by CI.
		-->
		<Version>3.0.0-dev</Version>
		<AssemblyTitle>SqlServiceBrokerListener</AssemblyTitle>
		<RootNamespace>SqlServiceBrokerListener</RootNamespace>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<AssemblyName>SqlServiceBrokerListener</AssemblyName>
		<PackageId>SqlServiceBrokerListener</PackageId>
		<Authors>Sebastian Huebener</Authors>
		<Copyright>Copyright © 2026 - Sebastian Huebener</Copyright>
		<NeutralLanguage>en</NeutralLanguage>
		<Title>SqlServiceBrokerListener</Title>
		<Description>Cross-platform SQL Server Service Broker listener that streams table change notifications into your .NET code. Targets .NET 10 and .NET 11 using Microsoft.Data.SqlClient. Learn more: https://github.com/shuebener/SqlServiceBrokerListener</Description>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;CS1591</NoWarn>
	</PropertyGroup>
	
	<PropertyGroup>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/shuebener/SqlServiceBrokerListener</PackageProjectUrl>
		<RepositoryUrl>https://github.com/shuebener/SqlServiceBrokerListener.git</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>		
		<IncludeSymbols>true</IncludeSymbols>		
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>MS SQL ServiceBroker</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	
	<ItemGroup>
		<None Remove="SqlServiceBrokerListener.xml" />
		<None Include="../../README.md" Pack="true" PackagePath="\" />
		<None Include="../../.github/**/*.*" Link=".github/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<!-- Direct reference overrides the transitive 9.0.18 pulled in by Microsoft.Data.SqlClient, which has known
			 vulnerabilities (NU1902 GHSA-2fmv-rv2c-59x7, NU1903 GHSA-846f-f764-76mx). Remove once SqlClient depends on a patched version. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
	</ItemGroup>
</Project>